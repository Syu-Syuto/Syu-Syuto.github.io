    <rect x="2.5" y="2.5" width="19" height="19" rx="5.8" />
    <circle cx="12" cy="12" r="4.35" />
    <circle cx="17.65" cy="6.45" r="1.25" fill="#b344a0" stroke="none" />
  </svg>
)}
{kind === 'x' && (
  <svg class="about-explore__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
